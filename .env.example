# 复制为 .env 即可生效（pnpm dev 启动时由 cross-env / Node 直接读取）
# .env 已被 .gitignore，不会进版本库

# ---------------- onerec 推荐引擎 ----------------
# 不配置时，pnpm dev 会读 mock-data/onerec/products.json
#
# 推荐用法：在 backend/onerec_service/ 启动 FastAPI sidecar 把 Python onerec 库
# 包成 HTTP（默认端口 8765），然后把 ONEREC_BASE_URL 指向它。
# 详见 backend/onerec_service/README.md
#
# ONEREC_BASE_URL=http://127.0.0.1:8765
# ONEREC_API_TOKEN=please-rotate-me        # sidecar 设置同名变量后强制鉴权
# ONEREC_TIMEOUT_MS=5000                   # 单次请求超时，默认 5000
# DEFAULT_USER_ID=1000000001

# ---------------- LLM ----------------
# 不配置时，pnpm dev 会按 mock-data/llm/chat-cases.json 脚本化下发
# 配置后，prodMiddleware 会真实调用 LLM 并把候选池注入 prompt

# 1) Anthropic Claude（默认）
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-sonnet-4-6
# LLM_API_KEY=sk-ant-xxxxxxxxxxxx

# 2) OpenAI 兼容协议（DeepSeek / Qwen / Moonshot / 智谱…）
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen2.5-72b-instruct
# LLM_API_KEY=sk-xxxxxxxxxxxx

# LLM 通用调参
# LLM_TEMPERATURE=0.4
# LLM_MAX_TOKENS=2048

# ---------------- 前端运行时（VITE_ 前缀方可暴露给浏览器） ----------------
# VITE_API_BASE=/api/v1
